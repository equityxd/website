---
import Layout from '../layouts/Layout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import profile from '../data/profile.json' assert { type: 'json' };

const { profile: p, experience, outcomes, competencies, tools, education, languages } = profile;

const toolEntries = Object.entries(tools).map(([category, items]) => ({ category, items }));
---
<Layout title={`${p.name} | ${p.tagline}`} description={p.quote}>
  <main>
    <!-- ============ HERO ============ -->
    <section id="home" class="section hero">
      <div class="reveal">
        <p class="eyebrow">{p.tagline}</p>
        <h1>{p.name}</h1>
        <p class="hero-subtitle">{p.role}</p>
        <p class="hero-quote">{p.quote}</p>
        <div class="hero-contact">
          <a href={`mailto:${p.mailto}`} class="hero-link">{p.mailto}</a>
          <span class="hero-dot">·</span>
          <a href={`tel:${p.tel}`} class="hero-link">{p.tel}</a>
          <span class="hero-dot">·</span>
          <a href={`https://${p.website}`} class="hero-link" target="_blank" rel="noopener">{p.website}</a>
        </div>
      </div>
    </section>

    <!-- ============ OUTCOMES ============ -->
    <section id="outcomes" class="section outcomes">
      <div class="section-head">
        <p class="section-label">At a glance</p>
        <h2 class="section-title">Numbers that back the narrative.</h2>
      </div>
      <div class="outcomes">
        {outcomes.map((stat) => (
          <div class="stat" key={stat.label}>
            <span class="stat-num">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ EXPERIENCE ============ -->
    <section id="experience" class="section experience">
      <div class="section-head">
        <h2 class="section-title">Experience</h2>
        <p class="section-sub">Where the impact has been, and where it's headed.</p>
      </div>
      <div class="timeline">
        {experience.map((exp) => (
          <ExperienceItem
            key={exp.id}
            title={exp.title}
            company={exp.company}
            location={exp.location}
            dateStart={exp.dateStart}
            dateEnd={exp.dateEnd}
            details={exp.details}
            highlight={exp.highlight}
          />
        ))}
      </div>
    </section>

    <!-- ============ CAPABILITIES ============ -->
    <section id="capabilities" class="section capabilities">
      <div class="section-head">
        <h2 class="section-title">Capabilities</h2>
        <p class="section-sub">Financial control, from close to strategy.</p>
      </div>
      <div class="capability-grid">
        {competencies.map((comp) => (
          <div class="capability-card" key={comp.group}>
            <p class="capability-group">{comp.group}</p>
            {comp.items.map((item) => (
              <p class="capability-item">· {item}</p>
            ))}
          </div>
        ))}
      </div>
      <div class="section-head mt">
        <h3 class="section-title-sm">Working Tools</h3>
      </div>
      <div class="tools-grid">
        {toolEntries.map((tool) => (
          <div class="tool-cat" key={tool.category}>
            <p class="tool-cat-title">{tool.category}</p>
            {tool.items.map((item) => (
              <span class="tool-tag">{item}</span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- ============ EDUCATION ============ -->
    <section id="education" class="section education">
      <div class="section-head">
        <h2 class="section-title">Education</h2>
      </div>
      <div class="education-list">
        {education.map((edu) => (
          <div class="edu-row" key={edu.org}>
            <div class="edu-main">
              <p class="edu-org">{edu.org}</p>
              <p class="edu-field">{edu.degree} · {edu.field}</p>
            </div>
            <div class="edu-meta">
              <p class="edu-date">{edu.dateStart} – {edu.dateEnd}</p>
              {edu.rank ? <p class="edu-rank">{edu.rank}</p> : null}
              <p class="edu-loc">{edu.location}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ LANGUAGES ============ -->
    <section id="languages" class="section languages">
      <div class="section-head">
        <h2 class="section-title">Languages</h2>
      </div>
      <div class="language-list">
        {languages.map((lang) => (
          <div class="lang-row" key={lang.level}>
            <span class="lang-level">{lang.level}</span>
            {lang.items.map((item) => (
              <span class="lang-item">{item}</span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="section contact">
      <div class="section-head">
        <h2 class="section-title">Let's build something.</h2>
        <p class="section-sub">Open to CFO, FP&amp;A and finance-trans engagements — remotely or on-site.</p>
      </div>
      <a href={`mailto:${p.mailto}`} class="cta-button">Get in touch</a>
      <p class="contact-note">Brussels, BE · Available for remote &amp; relokation</p>
    </section>
  </main>
</Layout>
