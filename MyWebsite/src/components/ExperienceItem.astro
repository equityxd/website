---
interface Props {
  title: string;
  subtitle?: string;
  company: string;
  dateStart: string | number;
  dateEnd?: string | number;
  location: string;
  sector?: string;
  details: string[];
  tags?: string[];
  categories?: string[];
  highlight?: boolean;
}

const { title, subtitle, company, sector, dateStart, dateEnd = "Present", location, details, tags = [], categories = [], hidden = false, highlight = false } = Astro.props;
---

<div class={`exp-card ${highlight ? 'featured' : ''}`} data-filters={[...categories, ...tags].join(' | ')} class:list={{ 'is-hidden': hidden }}>
  <div class="exp-head">
    <div>
      <h3 class="exp-role">{title}</h3>
      <div class="exp-company">{company}{sector ? ` · ${sector}` : ''}</div>
    </div>
    <div class="exp-meta">
      <div>{dateStart}{dateEnd !== 'Present' ? ` – ${dateEnd}` : ''}</div>
      <div>{location}</div>
    </div>
  </div>
  <div class="exp-cats">
    {subtitle && <span class="exp-cat exp-cat--role" data-cat={subtitle}>{subtitle}</span>}
    {categories.map((cat) => (
      <span class="exp-cat" data-cat={cat}>{cat}</span>
    ))}
  </div>
  <ul class="exp-details">
    {details.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <div class="exp-tags">
    {tags.map((tag) => (
      <button type="button" class="exp-tag" data-tag={tag} data-filter={tag}>{tag}</button>
    ))}
  </div>
</div>

<style>
  .exp-card { padding: 24px 26px; }
  .featured { border-color: rgba(217, 119, 6, 0.45); }
  .exp-head { gap: 16px; }
  .exp-meta { text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .exp-details { list-style: none; margin: 16px 0 0; padding: 0; }
  .exp-details li { padding-left: 18px; position: relative; margin-bottom: 8px; font-size: 0.92rem; color: var(--text); line-height: 1.5; }
  .exp-details li::before { content: ""; position: absolute; left: 6px; top: 11px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }

  /* Category chips — below company name, before bullets */
  .exp-cats { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 12px; }
  .exp-cat {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #0958b8;
    background: rgba(11, 111, 224, 0.10);
  }
  /* Engagement role (Freelancer / Internal) — solid, standout */
  .exp-cat--role {
    color: #fff;
    background: #0b6fe0;
  }

  /* Chips */
  .exp-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 14px; }
  .exp-tag {
    cursor: pointer;
    appearance: none;
    border: 0;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--accent-text);
    background: var(--surface);
    transition: background .2s ease, color .2s ease, border-color .2s ease, transform .1s ease;
  }
  .exp-tag:hover { background: var(--accent); color: #fff; }
  .exp-tag:active { transform: scale(0.96); }

  /* Filtered-out cards */
  .is-hidden { display: none; }
</style>
