---
interface Props {
  metric: string;
  title: string;
  company: string;
  situation: string;
  task: string;
  action: string;
  result: string;
  tags?: string[];
}

const { metric, title, company, situation, task, action, result, tags = [] } = Astro.props;
---
<div class="case" key={title}>
  <div class="case-metric">{metric}</div>
  <div class="case-head">
    <div>
      <h3 class="case-title">{title}</h3>
      <p class="case-company">{company}</p>
    </div>
  </div>
  <dl class="star">
    <div class="star-row">
      <dt class="star-label">Situation</dt>
      <dd class="body">{situation}</dd>
    </div>
    <div class="star-row">
      <dt class="star-label">Task</dt>
      <dd class="body">{task}</dd>
    </div>
    <div class="star-row">
      <dt class="star-label">Action</dt>
      <dd class="body">{action}</dd>
    </div>
    <div class="star-row star-result">
      <dt class="star-label">Result</dt>
      <dd class="body result-value">{result}</dd>
    </div>
  </dl>
  {tags.length > 0 && (
    <div class="case-tags">
      {tags.map((tag) => (
        <span class="case-tag">{tag}</span>
      ))}
    </div>
  )}
</div>

<style>
  .case {
    position: relative;
    padding: 26px 28px;
    border-radius: 18px;
    transition: border-color .3s ease, transform .3s ease, background .3s ease;
  }
  .case:hover {
    border-color: rgba(217, 119, 6, 0.5);
    transform: translateY(-3px);
  }
  .case-metric {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--surface-);
    border: 1px solid rgba(217, 119, 6, 0.35);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .case-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .case-title { margin: 0; font-size: 1.25rem; font-weight: 700; }
  .case-company { margin: 4px 0 0; font-size: 0.9rem; color: var(--text-dim); }
  .star { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .star-row { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: start; padding-bottom: 12px; border-bottom: 1px solid var(--surface-); }
  .star-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-top: 3px;
  }
  .star-body, .body { margin: 0; font-size: 0.92rem; color: var(--text); line-height: 1.55; }
  .star-result { border-bottom: 0; }
  .star-result .star-label { color: var(--accent-text); }
  .result-value { color: var(--text); font-weight: 600; }
  .case-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .case-tag {
    appearance: none;
    border: 0;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--accent-text);
    background: var(--surface-);
  }
  @media (max-width: 640px) {
    .star-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
